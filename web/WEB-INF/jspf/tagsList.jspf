<%-- any content can be specified here e.g.: --%>
<%@ page pageEncoding="UTF-8" %>
<style>
    .tag-container {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .tag-checkbox {
        display: none;
    }

    .tag-label {
        padding: 8px 14px;
        border: 1px solid #999;
        border-radius: 6px;
        cursor: pointer;
    }

    .tag-checkbox:checked + .tag-label {
        background-color: #333;
        color: white;
    }
</style>
<label>Tags:</label>
<div class="tag-container">
    <c:forEach var="tag" items="${tags.values()}">
        <input type="checkbox"
               id="tag_${tag.tagID}"
               name="tags"
               value="${tag.tagID}"
               class="tag-checkbox">
        <label for="tag_${tag.tagID}" class="tag-label">
            ${tag.tagName}
        </label>
    </c:forEach>
</div>
